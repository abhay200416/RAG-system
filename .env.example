# RAG System Configuration
# Copy this file to .env and fill in your values

# Application
RAG_APP_NAME=RAG System
RAG_APP_VERSION=0.1.0
RAG_DEBUG=false

# Logging
RAG_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
RAG_LOG_FORMAT=console      # console (colored) or json
RAG_LOG_FILE=./logs/rag.log # Optional: path to log file

# API Keys (required for LLM providers)
RAG_GOOGLE_API_KEY=replace_with_your_google_api_key
RAG_GROQ_API_KEY=replace_with_your_groq_api_key

# Model Configuration
RAG_DEFAULT_EMBEDDING_MODEL=gemini-embedding-2
RAG_DEFAULT_LLM_MODEL=gemini-3.5-flash-lite
RAG_GROQ_MODEL=qwen/qwen3.8-27b

# Vector Store
RAG_DATABASE_URL=postgresql+psycopg://rag:replace_with_postgres_password@localhost:5433/rag
RAG_COLLECTION_NAME=rag_documents

# Docker PostgreSQL
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace_with_a_64_character_hex_password
POSTGRES_PORT=5433

# Chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Retrieval
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Redis answer cache (optional; uncomment to enable)
# RAG_REDIS_URL=redis://localhost:6379/0
RAG_REDIS_CACHE_TTL_SECONDS=3600
RAG_REDIS_CACHE_PREFIX=rag

# Server
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_API_BASE_URL=http://localhost:8000
# Set a long, random value before exposing protected API routes.
RAG_API_AUTH_KEY=replace_with_a_random_secret
RAG_API_RATE_LIMIT_REQUESTS=60
RAG_API_RATE_LIMIT_WINDOW_SECONDS=60
RAG_API_RATE_LIMIT_PREFIX=rag:api-rate-limit

# Ingestion
RAG_MAX_FILE_SIZE_MB=100
# URL ingestion is disabled unless exact trusted hostnames are listed.
# RAG_INGEST_ALLOWED_HOSTS=["docs.example.com"]